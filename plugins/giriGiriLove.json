{
  "api": "2",
  "version": "2.7",
  "name": "girigiri愛動漫",
  "iconUrl": "https://ani.girigirilove.com/favicon.ico",
  "baseUrl": "https://ani.girigirilove.com",
  "searchUrl": "",
  "searchList": "",
  "searchName": "",
  "searchLink": "",
  "lineNames": "",
  "lineList": "",
  "episode": "",
  "searchMode": "api",
  "chapterMode": "api",
  "searchApiConfig": {
    "request": {
      "method": "GET",
      "url": "https://m3u8.girigirilove.com/api.php/Vod/get_list",
      "query": {
        "vod_name": "{keyword}",
        "offset": "0",
        "limit": "24"
      }
    },
    "listPath": "$.info.rows[*]",
    "namePath": "$.vod_name",
    "sourcePath": "$.vod_id",
    "sourceTemplate": ""
  },
  "chapterApiConfig": {
    "request": {
      "method": "GET",
      "url": "https://m3u8.girigirilove.com/api.php/Vod/get_detail",
      "query": {
        "vod_id": "{source}"
      }
    },
    "format": "delimited",
    "roadNamesPath": "$.info.vod_play_from",
    "roadEpisodesPath": "$.info.vod_play_url",
    "roadSeparator": "$$$",
    "episodeSeparator": "#",
    "fieldSeparator": "$",
    "episodePage": {
      "url": "https://pl.girigirilove.com/addons/aplyer/atom.php",
      "query": {
        "key": "0",
        "url": "{episodeUrl}"
      }
    }
  }
}
